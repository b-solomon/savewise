# SaveWise Environment Configuration Example
# Copy this file to .env and configure strong secrets before running in production

PORT=4000
NODE_ENV=development

# Authentication & Security
# Cryptographically random string (min 32 chars): e.g. openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long

# Dedicated Master Key for AES-256-GCM Encryption (separate from JWT_SECRET)
ENCRYPTION_MASTER_KEY=replace_with_secure_encryption_master_key_32_chars_min
ENCRYPTION_SALT=replace_with_secure_encryption_salt_value

# CORS Allowed Origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL for cloud, or omit for local SQLite)
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_FILE=savewise.db

# AI Financial Advisor (Optional: OpenRouter or OpenAI key; heuristic mode fallback if omitted)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
